#!/usr/bin/env python3
import hashlib
import json
import os
import os.path
import shellish


@shellish.autocommand
def addblocklisted(zwift_id_or_hash, dryrun=False):
    project_root = os.path.join(os.path.dirname(os.path.realpath(__file__)), '..')
    fname = os.path.join(project_root, 'products/sauce4zwift/exclusions.json')
    with open(fname) as f:
        blocklist = json.load(f)
    if len(zwift_id_or_hash) != 64:
        zid = int(zwift_id_or_hash)
        if str(zid) != zwift_id_or_hash:
            raise Exception("Invalid Number Value")
        idhash = hashlib.sha256(str(zid).encode()).hexdigest()
    else:
        idhash = zwift_id_or_hash
    blocklist.append({"idhash": idhash})
    if not dryrun:
        with open(fname, 'w') as f:
            json.dump(blocklist, f, indent=4)
        os.system(f'cd {project_root}; git commit products/sauce4zwift/exclusions.json && git push')
    else:
        print('Zwift ID:', idhash)

addblocklisted()
